# macOS
.DS_Store

# Xcode / SPM build output
build/
DerivedData/
*.xcodeproj/
# …but DO track the project file itself (structure + SPM package links live in git)
!MeetingTranscriber.xcodeproj/
MeetingTranscriber.xcodeproj/*
!MeetingTranscriber.xcodeproj/project.pbxproj
.swiftpm/
xcuserdata/
Package.resolved
!scripts/release/Package.resolved
# Pinned package versions for the app. Change them on purpose:
# edit project.yml, then `xcodebuild -resolvePackageDependencies`.
!MeetingTranscriber.xcodeproj/project.xcworkspace/
MeetingTranscriber.xcodeproj/project.xcworkspace/*
!MeetingTranscriber.xcodeproj/project.xcworkspace/xcshareddata/
MeetingTranscriber.xcodeproj/project.xcworkspace/xcshareddata/*
!MeetingTranscriber.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
MeetingTranscriber.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!MeetingTranscriber.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Generated app icons (regenerate with scripts/generate_app_icon.swift)
MeetingTranscriber/Resources/Assets.xcassets/AppIcon.appiconset/icon_*.png

# Local agent / assistant working directories
.agents/
.claude/
.superpowers/
skills-lock.json

# Release output
dist/
*.dmg

# Local Python verification caches
__pycache__/

# Private Apple signing/notarization credentials
*.p8
*.p12
